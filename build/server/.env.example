# Copy to .env and fill in. Never commit a real .env with a key in it.
# Required for chat; the server still starts without it, but /api/chat returns 503.
OPENAI_API_KEY=
# Vector store IDs (OpenAI dashboard / API) holding each tool's CPGs and sources.
# Used as the file_search tool's vector_store_ids. Leave blank to run without
# file search (the model then answers from the system prompt + scenario only).
ROLE1_VECTOR_STORE_ID=
FOXTWO_VECTOR_STORE_ID=
# Server port.
PORT=3000
# Model (default gpt-5.4) and sampling. See README "OpenAI request shape" note:
# GPT-5-family reasoning models reject non-default temperature, so
# OPENAI_TEMPERATURE is only sent when explicitly set here; leave blank for
# gpt-5.4. The server also retries once without temperature if OpenAI rejects it.
OPENAI_MODEL=gpt-5.4
OPENAI_TEMPERATURE=
OPENAI_MAX_OUTPUT_TOKENS=4096
# AAR report service (probe-confirmed working 2026-11-09).
AAR_SERVICE_URL=https://fox-two-aar.onrender.com
